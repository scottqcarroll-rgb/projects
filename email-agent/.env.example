# Yahoo OAuth2 Credentials (REQUIRED - get from https://developer.yahoo.com/apps/create/)
# Create an app with "mail-r" and "mail-w" scopes
# Required Redirect URI: http://localhost:8090/callback
# Required API Permissions: mail-r, mail-w
# Required OpenID Connect: openid, email, profile
YAHOO_CLIENT_ID=your-client-id-here
YAHOO_CLIENT_SECRET=your-client-secret-here

# Email address (your Bellsouth/Yahoo account)
YAHOO_EMAIL=sqc@bellsouth.net

# Gmail IMAP with App Password (simpler than OAuth2, recommended for headless)
GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password-no-spaces

# Gmail API OAuth2 (alternative - requires reauth.py when token expires)
# GMAIL_CREDENTIALS_FILE=credentials.json
# GMAIL_TOKEN_FILE=token.json

# Telegram Bot (for notifications)
TELEGRAM_BOT_TOKEN=8773175847:***
TELEGRAM_CHAT_ID=7542619200

# Optional: Anthropic API key for LLM-based classification
# ANTHROPIC_API_KEY=sk-ant-...