[Unit]
Description=Sam Hunter Federal Procurement Platform
After=network.target

[Service]
Type=simple
User=scott
WorkingDirectory=/home/scott/projects/govt-contracts/sam-hunter
ExecStart=/home/scott/projects/email-agent/venv/bin/python app.py
Restart=always
RestartSec=10
StandardOutput=append:/home/scott/projects/govt-contracts/sam-hunter/sam-hunter.log
StandardError=append:/home/scott/projects/govt-contracts/sam-hunter/sam-hunter.log

[Install]
WantedBy=multi-user.target