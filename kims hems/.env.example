# Production Environment Variables for Kim's Hems
# Copy this to .env and fill in your actual values
# NEVER commit .env to version control!

# Application
NODE_ENV=production
PORT=3000

# Email (Nodemailer) - Configure for form notifications
# SMTP settings for sending contact/booking emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
NOTIFY_EMAIL=kim@kimshems.com

# Security
# Generate a strong random string for session/CSRF if you add sessions later
SESSION_SECRET=generate-a-strong-random-string-here

# Rate limiting (handled by nginx, but can be used by app too)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100