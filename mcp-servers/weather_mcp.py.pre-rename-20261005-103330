#!/usr/bin/env python3
"""Weather MCP server wrapping Open-Meteo (free, no API key).

Defaults to Scott's saved location: Temple, GA (lat 33.7353, lon -85.0308),
matching projects/dashboard/data_fetcher.py. Two tools: current conditions and
a multi-day forecast for any place name or lat/lon.
"""
from __future__ import annotations

import httpx
from typing import Annotated, Optional
from pydantic import BaseModel, Field, ConfigDict
from mcp.server.fastmcp import FastMCP

mcp = FastMCP("weather_mcp")

API_BASE = "https://api.open-meteo.com/v1/forecast"
GEOCODE_BASE = "https://geocoding-api.open-meteo.com/v1/search"
DEFAULT_LAT = 33.7353
DEFAULT_LON = -85.0308
DEFAULT_TZ = "America/New_York"
DEFAULT_NAME = "Temple, GA"

WMO_CODES: dict[int, str] = {
    0: "Clear sky",
    1: "Mainly clear",
    2: "Partly cloudy",
    3: "Overcast",
    45: "Fog",
    48: "Depositing rime fog",
    51: "Light drizzle",
    53: "Moderate drizzle",
    55: "Dense drizzle",
    56: "Light freezing drizzle",
    57: "Dense freezing drizzle",
    61: "Slight rain",
    63: "Moderate rain",
    65: "Heavy rain",
    66: "Light freezing rain",
    67: "Heavy freezing rain",
    71: "Slight snow",
    73: "Moderate snow",
    75: "Heavy snow",
    77: "Snow grains",
    80: "Slight rain showers",
    81: "Moderate rain showers",
    82: "Violent rain showers",
    85: "Slight snow showers",
    86: "Heavy snow showers",
    95: "Thunderstorm",
    96: "Thunderstorm with slight hail",
    99: "Thunderstorm with heavy hail",
}


def c_to_f(c: float | None) -> str:
    return "N/A" if c in (None, "N/A") else f"{round(c * 9 / 5 + 32)}°F"


async def fetch_open_meteo(
    lat: float,
    lon: float,
    tz: str = DEFAULT_TZ,
    hourly: str | None = None,
    daily: str | None = None,
    forecast_days: int | None = None,
) -> dict:
    params = {
        "latitude": lat,
        "longitude": lon,
        "current": (
            "temperature_2m,relative_humidity_2m,apparent_temperature,"
            "weather_code,wind_speed_10m,wind_direction_10m,pressure_msl"
        ),
        "timezone": tz,
    }
    if hourly:
        params["hourly"] = hourly
    if daily:
        params["daily"] = daily
    if forecast_days:
        params["forecast_days"] = forecast_days
    async with httpx.AsyncClient(timeout=30.0) as client:
        r = await client.get(API_BASE, params=params)
        r.raise_for_status()
        return r.json()


async def geocode(name: str) -> tuple[float, float, str]:
    """Resolve a place name to (lat, lon, label) via Open-Meteo geocoding.

    Open-Meteo only matches the comma form "City, ST"; "City ST" yields no
    results, so retry with a comma before a trailing state token. The returned
    label always includes the state, because bare names are ambiguous -- plain
    "Temple" resolves to Temple, Texas, not Temple, Georgia.
    """
    candidates = [name]
    head, _, tail = name.rpartition(" ")
    if head and tail and len(tail) <= 12:
        candidates.append(f"{head}, {tail}")

    async with httpx.AsyncClient(timeout=30.0) as client:
        for cand in dict.fromkeys(candidates):
            r = await client.get(GEOCODE_BASE, params={"name": cand, "count": 1})
            r.raise_for_status()
            results = r.json().get("results") or []
            if results:
                hit = results[0]
                label = hit.get("name") or name
                if hit.get("admin1"):
                    label = f"{label}, {hit['admin1']}"
                return float(hit["latitude"]), float(hit["longitude"]), label
    raise ValueError(
        f"Location '{name}' not found. Use 'City, ST' with a comma, e.g. 'Temple, GA'."
    )


class LocationInput(BaseModel):
    model_config = ConfigDict(str_strip_whitespace=True)

    name: Annotated[
        str,
        Field(
            description=(
                "City/place name to look up, comma before state (e.g. 'Austin, TX', 'Temple, GA'). "
                "Leave empty to use Scott's default home in Temple, GA, unless "
                "coordinates are supplied."
            )
        ),
    ] = ""
    latitude: Annotated[
        Optional[float],
        Field(description="Latitude. Supply with longitude; takes priority over name."),
    ] = None
    longitude: Annotated[
        Optional[float],
        Field(description="Longitude. Supply with latitude; takes priority over name."),
    ] = None


class ForecastInput(BaseModel):
    model_config = ConfigDict(str_strip_whitespace=True)

    name: Annotated[
        str, Field(description="City/place name, comma before state (e.g. 'Denver, CO'). Empty uses Scott's default home (Temple, GA).")
    ] = ""
    days: Annotated[
        int, Field(description="Number of forecast days starting today (1-16).", ge=1, le=16)
    ] = 5
    latitude: Annotated[
        Optional[float],
        Field(description="Latitude. Supply with longitude; takes priority over name."),
    ] = None
    longitude: Annotated[
        Optional[float],
        Field(description="Longitude. Supply with latitude; takes priority over name."),
    ] = None


async def resolve(loc) -> tuple[float, float, str]:
    """Resolve a location request to (lat, lon, label).

    Precedence: explicit coordinates, then place name, then the saved default.
    The returned label and coordinates always describe what was actually
    queried, so callers can verify the tool answered the right place.
    """
    if loc.latitude is not None and loc.longitude is not None:
        label = loc.name or f"{loc.latitude:.4f},{loc.longitude:.4f}"
        return float(loc.latitude), float(loc.longitude), label
    if loc.name:
        return await geocode(loc.name)
    return DEFAULT_LAT, DEFAULT_LON, DEFAULT_NAME


def coerce_location(value) -> LocationInput:
    """Accept a bare string, a mapping, or a LocationInput.

    Models frequently pass a plain place name ("Mobile") where the structured
    object is expected, which used to raise a pydantic validation error and
    waste a tool call. A string of the form "lat,lon" is treated as coordinates.
    """
    if isinstance(value, LocationInput):
        return value
    if isinstance(value, str):
        parts = [p.strip() for p in value.split(",")]
        if len(parts) == 2:
            try:
                return LocationInput(latitude=float(parts[0]), longitude=float(parts[1]))
            except ValueError:
                pass
        return LocationInput(name=value)
    if isinstance(value, dict):
        return LocationInput.model_validate(value)
    return LocationInput(name=str(value))


def coerce_forecast(value) -> ForecastInput:
    """Accept a bare string, a mapping, or a ForecastInput."""
    if isinstance(value, ForecastInput):
        return value
    if isinstance(value, dict):
        # Validate directly so fields like 'days' survive.
        return ForecastInput.model_validate(value)
    loc = coerce_location(value)
    return ForecastInput(name=loc.name, latitude=loc.latitude, longitude=loc.longitude)


@mcp.tool()
async def weather_current(location: LocationInput | str) -> dict:
    """Get current weather conditions for a place.

    Free via Open-Meteo (no API key). Accepts a place name as a plain string
    ("Denver, CO") or a structured object with name and/or latitude/longitude;
    coordinates take priority. Defaults to Scott's home in Temple, GA when
    neither is given.

    The returned 'location', 'latitude' and 'longitude' always reflect the point
    actually queried — check them against the request rather than assuming.
    """
    lat, lon, label = await resolve(coerce_location(location))
    data = await fetch_open_meteo(lat, lon)
    cur = data.get("current", {})
    code = cur.get("weather_code")
    return {
        "location": label,
        "latitude": lat,
        "longitude": lon,
        "temperature_f": c_to_f(cur.get("temperature_2m")),
        "feels_like_f": c_to_f(cur.get("apparent_temperature")),
        "condition": WMO_CODES.get(code, f"Unknown ({code})"),
        "humidity_pct": cur.get("relative_humidity_2m"),
        "wind_mph": round((cur.get("wind_speed_10m") or 0) * 0.621371, 1),
        "pressure_hpa": cur.get("pressure_msl"),
    }


@mcp.tool()
async def weather_forecast(location: ForecastInput | str) -> list[dict]:
    """Get a multi-day high/low forecast for a place.

    Free via Open-Meteo (no API key). Accepts a place name as a plain string
    ("Denver, CO") or a structured object with name and/or latitude/longitude;
    coordinates take priority. Defaults to Scott's home in Temple, GA when
    neither is given.

    Each entry repeats the resolved 'location', 'latitude' and 'longitude' so the
    caller can confirm the forecast covers the place that was requested.
    """
    loc = coerce_forecast(location)
    lat, lon, label = await resolve(loc)
    data = await fetch_open_meteo(
        lat,
        lon,
        daily="temperature_2m_max,temperature_2m_min,precipitation_sum,weather_code",
        forecast_days=loc.days,
    )
    d = data.get("daily", {})
    times = d.get("time", [])
    out = []
    for i, day in enumerate(times):
        code = d["weather_code"][i] if "weather_code" in d else -1
        out.append(
            {
                "date": day,
                "location": label,
                "latitude": lat,
                "longitude": lon,
                "high_f": c_to_f(d.get("temperature_2m_max", [None])[i]),
                "low_f": c_to_f(d.get("temperature_2m_min", [None])[i]),
                "condition": WMO_CODES.get(code, f"Unknown ({code})"),
                "precip_mm": d.get("precipitation_sum", [None])[i],
            }
        )
    return out


if __name__ == "__main__":
    mcp.run()